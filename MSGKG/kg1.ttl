msgkg:usesProgram rdf:type rdf:Property .
msgkg:usesEngagementTool rdf:type rdf:Property .
msgkg:promotesCulture rdf:type rdf:Property .
msgkg:supportsGroup rdf:type rdf:Property .
msgkg:adaptsTalentPolicy rdf:type rdf:Property .
msgkg:hasOperatingModel rdf:type rdf:Property .

#################################################
# === DATA PROPERTIES
#################################################

msgkg:metricValue rdf:type rdf:Property .
msgkg:metricDate rdf:type rdf:Property .

#################################################
# === COMPANY INSTANCES
#################################################

msgkg:AMD rdf:type msgkg:Company .
