@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################
# === CLASSES
#################################################

msgkg:Company rdf:type rdfs:Class .
msgkg:Mission rdf:type rdfs:Class .
msgkg:Vision rdf:type rdfs:Class .
msgkg:StrategicObjective rdf:type rdfs:Class .
msgkg:Capability rdf:type rdfs:Class .
msgkg:Initiative rdf:type rdfs:Class .
msgkg:HumanCapitalMetric rdf:type rdfs:Class .

#################################################
# === OBJECT PROPERTIES
#################################################

msgkg:hasMission rdf:type rdf:Property .
msgkg:pursuesObjective rdf:type rdf:Property .
msgkg:buildsCapability rdf:type rdf:Property .
msgkg:pursuesInitiative rdf:type rdf:Property .
