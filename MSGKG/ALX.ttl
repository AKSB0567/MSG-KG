        "Flushing Property" ;
    msg:text "167,000 square foot building located on Roosevelt Avenue and Main Street in Queens, subleased to New World Mall LLC" .

inst:BusinessSegment_ALX_rego-park-i a msg:BusinessSegment ;
    msg:segmentName "Rego Park I" ;
    msg:text "338,000 square foot shopping center located on Queens Boulevard and 63rd Road in Queens" .

inst:BusinessSegment_ALX_rego-park-ii a msg:BusinessSegment ;
    msg:segmentName "Rego Park II" ;
    msg:text "615,000 square foot shopping center located adjacent to Rego Park I in Queens" .

inst:BusinessSegment_ALX_the-alexander-apartment-tower a msg:BusinessSegment ;
    msg:segmentName "The Alexander Apartment Tower" ;
    msg:text "312 units aggregating 255,000 square feet, located above Rego Park II shopping center" .

