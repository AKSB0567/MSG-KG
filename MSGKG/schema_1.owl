  <rdf:Description rdf:about="http://msgkg.io/ontology#RiskTheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Risk Theme</rdfs:label>
    <rdfs:comment>A thematic risk category to which the company is exposed.</rdfs:comment>
