    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Span</rdfs:label>
    <rdfs:comment>A character-level span within a document that provides provenance for an assertion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#initiativeEnables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
