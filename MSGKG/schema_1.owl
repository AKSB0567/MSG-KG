    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#Regulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#BusinessSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Business Segment</rdfs:label>
