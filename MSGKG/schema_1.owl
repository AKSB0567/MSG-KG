    <rdfs:label>Regulation</rdfs:label>
    <rdfs:comment>A regulatory framework or regulation affecting the company.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#supportsObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>supports objective</rdfs:label>
