    <rdfs:label>URL</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#segmentHasMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>segment has metric</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#BusinessSegment"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#FinancialMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#metricPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
