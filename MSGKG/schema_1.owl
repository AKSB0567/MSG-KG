<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://msgkg.io/ontology#riskCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>risk category</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#RiskTheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#confidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>confidence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>A product or service offered by the company.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#spanEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>span end</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Span"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Document</rdfs:label>
    <rdfs:comment>A source document (e.g. 10-K, proxy filing) from which knowledge is extracted.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#hasMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has mission</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#Mission"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#officerTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>officer title</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#ExecutiveOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Mission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mission</rdfs:label>
    <rdfs:comment>A company's stated mission — the core purpose it exists to fulfill.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#companyName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>company name</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#filingYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>filing year</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#statesObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>states objective</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#StrategicObjective"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Portfolio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Portfolio</rdfs:label>
    <rdfs:comment>An investment portfolio, identified by an owner and portfolio ID.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Portfolio"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>MSGKG Ontology v2</rdfs:label>
    <rdfs:comment>Mission, Strategy, and Goals Knowledge Graph ontology with FIBO alignment. Covers company strategy, capabilities, initiatives, risk themes, business segments, financial metrics, products, and portfolio holdings.</rdfs:comment>
    <owl:versionInfo>2.0</owl:versionInfo>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#ownerType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>owner type</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Portfolio"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Initiative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Initiative</rdfs:label>
    <rdfs:comment>A concrete programme or project the company is actively pursuing.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#weight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>weight</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Holding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#hasSubsidiary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has subsidiary</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#Subsidiary"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#priority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>priority</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#StrategicObjective"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#reportsMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>reports metric</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Company"/>
    <rdfs:range rdf:resource="http://msgkg.io/ontology#FinancialMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#capabilityName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>capability name</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#Capability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Company">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Company</rdfs:label>
    <rdfs:comment>A publicly listed or private company, identified by CIK and/or ticker.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#objectiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>objective type</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#StrategicObjective"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#Security">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Security</rdfs:label>
    <rdfs:comment>A tradeable financial security such as a stock or bond.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Security"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#riskName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>risk name</rdfs:label>
    <rdfs:domain rdf:resource="http://msgkg.io/ontology#RiskTheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://msgkg.io/ontology#regulatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
