inst:0000004904_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "AMERICAN ELECTRIC POWER CO INC — BusinessOperations" ;
    sec:hasBusinessRelationship "Members of PJM and SPP FERC-approved Regional Transmission Organizations",
