    sec:hasKeyFinancialMetric "ETT investment in ERCOT projects expected to be $5.0 billion by 2030" ;
    sec:hasSECCIK "0000004904" ;
    sec:hasSICCode "ELECTRIC SERVICES [4911]" ;
    sec:hasSubsidiary "APCo, I&M, KGPCo, KPCo, WPCo, OPCo, PSO, SWEPCo (utility subsidiaries)" ;
    sec:incorporatedIn inst:jurisdiction_New_York ;
    sec:isSubjectToRegulation "I&M subject to NRC regulation for Cook Plant nuclear operations",
