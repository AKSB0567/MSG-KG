    rdfs:range xsd:string .

sec:Industry a owl:Class ;
    rdfs:label "Industry" ;
    rdfs:comment "An industry or sector." .

sec:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "A jurisdiction of incorporation." .

sec:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographic location." .

sec:Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "A publicly traded company filing SEC 10-K reports." .

sec:Filing a owl:Class ;
    rdfs:label "Filing" ;
    rdfs:comment "A specific SEC 10-K filing." .

sec:CompensationAndBenefits a owl:Class ;
    rdfs:label "CompensationAndBenefits" ;
    rdfs:comment "Compensation philosophy, pay equity, and benefits." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:CultureAndValues a owl:Class ;
    rdfs:label "CultureAndValues" ;
    rdfs:comment "Company culture, core values, ethics, and code of conduct." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:DiversityEquityInclusion a owl:Class ;
    rdfs:label "DiversityEquityInclusion" ;
    rdfs:comment "Diversity, equity, inclusion, and belonging programs." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:EngagementAndRetention a owl:Class ;
    rdfs:label "EngagementAndRetention" ;
    rdfs:comment "Employee engagement, retention, and turnover." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:SafetyAndHealth a owl:Class ;
    rdfs:label "SafetyAndHealth" ;
    rdfs:comment "Workplace safety, health programs, and safety metrics." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:HumanCapitalManagement a owl:Class ;
    rdfs:label "HumanCapitalManagement" ;
    rdfs:comment "Human capital management disclosures." .

sec:Mission a owl:Class ;
    rdfs:label "Mission" ;
    rdfs:comment "Mission, purpose, and vision statements." .

sec:TrainingAndDevelopment a owl:Class ;
    rdfs:label "TrainingAndDevelopment" ;
    rdfs:comment "Training, learning, and professional development." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:WorkforceComposition a owl:Class ;
    rdfs:label "WorkforceComposition" ;
    rdfs:comment "Employee count, demographics, and workforce structure." ;
    rdfs:subClassOf sec:HumanCapitalManagement .

sec:BusinessOperations a owl:Class ;
    rdfs:label "BusinessOperations" ;
    rdfs:comment "Core business operations, segments, and strategy." .

