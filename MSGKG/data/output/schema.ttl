    sec:belongsToCategory sec:DiversityEquityInclusion ;
    rdfs:comment "An employee resource group (ERG)." ;
    rdfs:domain sec:DiversityEquityInclusion ;
    rdfs:range xsd:string .

sec:hasEngagementScore a owl:DatatypeProperty ;
    rdfs:label "Engagement Score" ;
    sec:belongsToCategory sec:EngagementAndRetention ;
    rdfs:comment "Employee engagement survey result or metric." ;
    rdfs:domain sec:EngagementAndRetention ;
    rdfs:range xsd:string .

sec:hasEnvironmentalLiability a owl:DatatypeProperty ;
    rdfs:label "Environmental Liability" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Environmental liability or remediation." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasFacility a owl:DatatypeProperty ;
    rdfs:label "Facility" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "A major facility or plant location." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasFiling a owl:ObjectProperty ;
    rdfs:label "Has Filing" ;
    rdfs:comment "Links a company to its SEC 10-K filing." ;
    rdfs:domain sec:Company ;
    rdfs:range sec:Filing .

sec:hasFilingDate a owl:DatatypeProperty ;
    rdfs:label "Filing Date" ;
    rdfs:comment "Date filed with the SEC." ;
