sec:hasSustainabilityGoal a owl:DatatypeProperty ;
    rdfs:label "Sustainability Goal" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "A specific sustainability target." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasSustainabilityProgram a owl:DatatypeProperty ;
    rdfs:label "Sustainability Program" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Environmental or sustainability initiative." ;
