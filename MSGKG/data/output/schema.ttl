@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sec: <http://example.org/sec10k/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sec:SEC10KOntology a owl:Ontology ;
    rdfs:label "SEC 10-K Knowledge Graph Ontology v2" ;
    rdfs:comment "Ontology for mission and human capital semantics extracted from SEC 10-K filings with category hierarchy." .

sec:belongsToCategory a owl:AnnotationProperty ;
    rdfs:label "Belongs To Category" ;
    rdfs:comment "Links a property to its semantic category class." .

sec:competesWith a owl:DatatypeProperty ;
    rdfs:label "Competes With" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Competitor or competitive landscape." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:foundedInYear a owl:DatatypeProperty ;
    rdfs:label "Year Founded" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Year the company was founded." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:gYear .

sec:hasAccessionNumber a owl:DatatypeProperty ;
    rdfs:label "Accession Number" ;
    rdfs:comment "SEC accession number." ;
    rdfs:domain sec:Filing ;
    rdfs:range xsd:string .

sec:hasBrand a owl:DatatypeProperty ;
    rdfs:label "Brand" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "A brand owned by the company." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasBusinessRelationship a owl:DatatypeProperty ;
    rdfs:label "Business Relationship" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Key business partnership or relationship." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasBusinessSegment a owl:DatatypeProperty ;
    rdfs:label "Business Segment" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "A reportable business segment." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasCarbonCapture a owl:DatatypeProperty ;
    rdfs:label "Carbon Capture" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Carbon capture or emissions initiative." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasCodeOfConduct a owl:DatatypeProperty ;
    rdfs:label "Code of Conduct" ;
    sec:belongsToCategory sec:CultureAndValues ;
    rdfs:comment "Employee code of conduct or ethics policy." ;
    rdfs:domain sec:CultureAndValues ;
    rdfs:range xsd:string .

sec:hasCompensationPhilosophy a owl:DatatypeProperty ;
    rdfs:label "Compensation Philosophy" ;
    sec:belongsToCategory sec:CompensationAndBenefits ;
    rdfs:comment "Compensation and pay philosophy." ;
    rdfs:domain sec:CompensationAndBenefits ;
    rdfs:range xsd:string .

sec:hasCompetitiveDifferentiator a owl:DatatypeProperty ;
    rdfs:label "Competitive Differentiator" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Strategic differentiator." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasCompetitiveRisk a owl:DatatypeProperty ;
    rdfs:label "Competitive Risk" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Competitive risk or challenge." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasContractorCount a owl:DatatypeProperty ;
    rdfs:label "Contractor Count" ;
    sec:belongsToCategory sec:WorkforceComposition ;
    rdfs:comment "Number of contract or temporary workers." ;
    rdfs:domain sec:WorkforceComposition ;
    rdfs:range xsd:string .

sec:hasCoreValue a owl:DatatypeProperty ;
    rdfs:label "Core Value" ;
    sec:belongsToCategory sec:CultureAndValues ;
    rdfs:comment "A stated core value of the company." ;
    rdfs:domain sec:CultureAndValues ;
    rdfs:range xsd:string .

sec:hasCulturalPillar a owl:DatatypeProperty ;
    rdfs:label "Cultural Pillar" ;
    sec:belongsToCategory sec:CultureAndValues ;
    rdfs:comment "A cultural pillar or guiding principle." ;
    rdfs:domain sec:CultureAndValues ;
    rdfs:range xsd:string .

sec:hasDEIMetric a owl:DatatypeProperty ;
    rdfs:label "DEI Metric" ;
    sec:belongsToCategory sec:DiversityEquityInclusion ;
    rdfs:comment "Quantitative DEI metric (e.g. % women, % minority)." ;
    rdfs:domain sec:DiversityEquityInclusion ;
    rdfs:range xsd:string .

sec:hasDEIProgram a owl:DatatypeProperty ;
    rdfs:label "DEI Program" ;
    sec:belongsToCategory sec:DiversityEquityInclusion ;
    rdfs:comment "Diversity, equity, and inclusion program." ;
    rdfs:domain sec:DiversityEquityInclusion ;
    rdfs:range xsd:string .

sec:hasDisclosure a owl:ObjectProperty ;
    rdfs:label "Has Disclosure" ;
    rdfs:comment "Links a company to a category-typed disclosure section extracted from its 10-K filing." ;
    rdfs:domain sec:Company .

sec:hasDistributionChannel a owl:DatatypeProperty ;
    rdfs:label "Distribution Channel" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "How products/services reach customers." ;
