    sec:belongsToCategory sec:TrainingAndDevelopment ;
    rdfs:comment "Investment in employee development." ;
    rdfs:domain sec:TrainingAndDevelopment ;
    rdfs:range xsd:string .

sec:isAffectedBy a owl:DatatypeProperty ;
    rdfs:label "Affected By" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "External factor affecting the company." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:isSubjectToRegulation a owl:DatatypeProperty ;
    rdfs:label "Subject to Regulation" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Regulatory framework or body." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:launchedRoutes a owl:DatatypeProperty ;
