    rdfs:domain sec:SafetyAndHealth ;
    rdfs:range xsd:string .

sec:hasHub a owl:DatatypeProperty ;
    rdfs:label "Hub" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Key operational hub or gateway." ;
    rdfs:domain sec:BusinessOperations ;
    rdfs:range xsd:string .

sec:hasIntellectualProperty a owl:DatatypeProperty ;
    rdfs:label "Intellectual Property" ;
    sec:belongsToCategory sec:BusinessOperations ;
    rdfs:comment "Patents, trademarks, or IP portfolio." ;
