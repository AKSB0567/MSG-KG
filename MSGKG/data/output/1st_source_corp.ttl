inst:0000034782_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "1ST SOURCE CORP — BusinessOperations" ;
    sec:foundedInYear "1971"^^xsd:gYear ;
    sec:hasBusinessSegment "Specialty Finance Group with 18 locations nationwide" ;
    sec:hasFacility "77 banking center locations in 18 counties in Indiana, Michigan, and Sarasota County, Florida" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasKeyFinancialMetric "Consolidated total assets of $8.93 billion as of Dec 31, 2024",
        "Total deposits of $7.23 billion as of Dec 31, 2024",
        "Total loans and leases of $6.85 billion as of Dec 31, 2024",
        "Total shareholders equity of $1.11 billion as of Dec 31, 2024" ;
    sec:hasMarketPosition "Forbes Americas Best Banks; Forbes Best-In-State Bank for 3rd consecutive year (2024)" ;
    sec:hasSECCIK "0000034782" ;
    sec:hasSICCode "6022" ;
    sec:hasSubsidiary "1st Source Bank" ;
    sec:headquarteredIn inst:location_South_Bend_Indiana ;
    sec:incorporatedIn inst:jurisdiction_IN ;
    sec:operatesInIndustry inst:industry_Bank_holding_company_providing_financial_products_and_services ;
    sec:operatesInRegion "Indiana, Michigan, Florida, and nationwide (Specialty Finance)" ;
    sec:providesService "Commercial and consumer banking, trust and wealth advisory, and insurance services",
        "Renewable energy financing for commercial solar projects across contiguous US",
        "Specialized financing for construction equipment, aircraft, and fleet vehicles",
        "Trust, investment, agency, and custodial services for individuals, estates, and corporates" .

