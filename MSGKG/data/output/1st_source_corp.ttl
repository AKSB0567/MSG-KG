    rdfs:label "1ST SOURCE CORP — CompensationAndBenefits" ;
    sec:offersBenefit "Tuition Reimbursement Program: over $132,500 reimbursed in 2024, avg ~$3,900 per colleague" .

inst:0000034782_DiversityEquityInclusion a sec:DiversityEquityInclusion ;
    rdfs:label "1ST SOURCE CORP — DiversityEquityInclusion" ;
    sec:hasDEIMetric "42% of Board Members (5 of 12) are women or minority",
