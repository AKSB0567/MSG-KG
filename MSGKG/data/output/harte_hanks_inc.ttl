inst:company_0000045919 a sec:Company ;
    rdfs:label "HARTE HANKS INC" ;
    sec:hasDisclosure inst:0000045919_BusinessOperations,
        inst:0000045919_CompensationAndBenefits,
        inst:0000045919_DiversityEquityInclusion,
        inst:0000045919_TrainingAndDevelopment,
        inst:0000045919_WorkforceComposition ;
    sec:hasFiling inst:filing_0000045919_25_000008 .

inst:0000045919_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "HARTE HANKS INC — BusinessOperations" ;
    sec:foundedInYear "1920"^^xsd:gYear ;
    sec:hasCompetitiveDifferentiator "Alignment of customers and products on behalf of brands along entire lifecycle" ;
    sec:hasSECCIK "0000045919" ;
    sec:hasSICCode "7331 - Direct Mail Advertising Services" ;
    sec:hasTechnologyPlatform "AI-powered approaches and solutions for marketing, sales, fulfillment and customer care" ;
    sec:incorporatedIn inst:jurisdiction_Delaware ;
    sec:operatesInIndustry inst:industry_Customer_and_brand_experience_services ;
    sec:operatesInRegion "North America, Asia-Pacific and Europe" ;
    sec:providesService "Data, marketing, sales, customer care, fulfillment and logistics services" ;
    sec:servesCustomerSegment "B2B Technology, Healthcare, Consumer Products, Financial Services, Automotive, Retail" .

inst:0000045919_CompensationAndBenefits a sec:CompensationAndBenefits ;
    rdfs:label "HARTE HANKS INC — CompensationAndBenefits" ;
    sec:hasCompensationPhilosophy "Competitive salaries and wages with comprehensive insurance options" ;
    sec:offersBenefit "401(k) retirement plan with company match; employee and matching contributions vest immediately",
        "Medical, prescription drug, vision, dental; company-paid life insurance, AD&D, short/long-term disability" .

inst:0000045919_DiversityEquityInclusion a sec:DiversityEquityInclusion ;
