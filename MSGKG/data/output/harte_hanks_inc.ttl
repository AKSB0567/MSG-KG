inst:0000045919_TrainingAndDevelopment a sec:TrainingAndDevelopment ;
    rdfs:label "HARTE HANKS INC — TrainingAndDevelopment" ;
    sec:hasTrainingProgram "Technical skill development, soft skills development, workplace conduct guidance, IT security training" .

inst:0000045919_WorkforceComposition a sec:WorkforceComposition ;
    rdfs:label "HARTE HANKS INC — WorkforceComposition" ;
    sec:hasEmployeeCount "1,715 full-time and 288 part-time employees as of December 31, 2024" ;
    sec:hasUnionRepresentation "No workforce represented by labor unions" ;
    sec:hasWorkforceDiversityMetric "Employed individuals from 6 different countries as of December 31, 2024" ;
