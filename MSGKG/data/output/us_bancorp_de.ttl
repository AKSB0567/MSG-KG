inst:0000036104_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "US BANCORP \\DE\\ — BusinessOperations" ;
    sec:competesWith "Commercial banks, savings associations, finance companies, credit unions, fintechs, credit card companies" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasGovernanceStructure "Board Compensation and Human Resources Committee oversees human capital management" ;
    sec:hasSECCIK "0000036104" ;
