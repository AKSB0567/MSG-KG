inst:0000050863_CompensationAndBenefits a sec:CompensationAndBenefits ;
    rdfs:label "INTEL CORP — CompensationAndBenefits" ;
    sec:hasPayEquityMetric "Achieved gender pay equity globally and race/ethnicity pay equity in the US since 2019" ;
    sec:offersBenefit "Market-competitive pay, stock grants, bonuses, ESPP, healthcare, retirement, family leave, sabbaticals" .

inst:0000050863_CultureAndValues a sec:CultureAndValues ;
    rdfs:label "INTEL CORP — CultureAndValues" ;
    sec:hasCodeOfConduct "Intel Code of Conduct and Global Human Rights Principles" ;
    sec:hasCoreValue "Customer first, fearless innovation, results driven, one Intel, inclusion, quality, and integrity" ;
    sec:hasCulturalPillar "Culture of continuous improvement with performance management supporting disciplined execution" .

inst:0000050863_DiversityEquityInclusion a sec:DiversityEquityInclusion ;
