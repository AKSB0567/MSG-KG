    sec:hasDEIProgram "Diversity and inclusion metrics linked to executive and employee compensation in 2024" .

inst:0000050863_EngagementAndRetention a sec:EngagementAndRetention ;
    rdfs:label "INTEL CORP — EngagementAndRetention" ;
    sec:hasEngagementScore "Annual employee experience survey with bonus linked to year-over-year survey improvements" ;
