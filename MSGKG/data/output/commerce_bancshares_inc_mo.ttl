    sec:hasBusinessSegment "Commercial",
        "Consumer",
        "Wealth" ;
    sec:hasCompetitiveDifferentiator "Super-community banking format with large bank products and deep local market knowledge" ;
    sec:hasFacility "142 branch facilities across Missouri, Kansas, central Illinois, Oklahoma, and Colorado" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasHub "St. Louis and Kansas City serve as central hubs" ;
    sec:hasKeyFinancialMetric "Consolidated assets $32.0B, loans $17.2B, deposits $25.3B, equity $3.3B at Dec 31, 2024" ;
    sec:hasKeyMetric "Approximately 10% deposit market share in Kansas City and 7% in St. Louis" ;
    sec:hasMarketPosition "One of the nation's top 50 bank holding companies based on asset size" ;
    sec:hasSECCIK "0000022356" ;
    sec:hasSICCode "6022 - State Commercial Banks" ;
