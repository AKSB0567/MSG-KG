inst:0000022356_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "COMMERCE BANCSHARES INC /MO/ — BusinessOperations" ;
    sec:competesWith "Banks, credit unions, brokerage companies, mortgage companies, insurance companies, fintech, e-commerce companies" ;
