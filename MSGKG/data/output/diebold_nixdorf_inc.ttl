inst:0000028823_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "DIEBOLD NIXDORF, Inc — BusinessOperations" ;
    sec:hasBusinessSegment "Banking segment",
        "Retail segment" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasKeyFinancialMetric "Product backlog approximately $800M as of December 31, 2024 (vs $1,100M in 2023)" ;
    sec:hasKeyMetric "Over 50% of revenues derived from service business" ;
    sec:hasMarketPosition "Global market leader in mission-critical hardware, software, and services for banking and retail" ;
    sec:hasSECCIK "0000028823" ;
    sec:hasSICCode "3578 - Calculating & Accounting Machines (No Electronic Computers)" ;
    sec:hasTechnologyPlatform "DN Series innovation for banking and retail automation",
        "The Exchange - internal intranet for employee communications" ;
