    sec:operatesInIndustry inst:industry_Banking_and_retail_automation_digitization_and_transformation ;
    sec:operatesInRegion "Presence in more than 100 countries" ;
    sec:providesService "Mission-critical hardware, software, and services for banking and retail clients" ;
    sec:servesCustomerSegment "Majority of world top 100 financial institutions",
        "Top 10 global Fortune 500 petroleum companies and top 25 global retailers" .

inst:0000028823_CompensationAndBenefits a sec:CompensationAndBenefits ;
    rdfs:label "DIEBOLD NIXDORF, Inc — CompensationAndBenefits" ;
    sec:hasCompensationPhilosophy "Pay for performance culture aligning long-term pay and performance" .

inst:0000028823_CultureAndValues a sec:CultureAndValues ;
