inst:company_0000028823 a sec:Company ;
    rdfs:label "DIEBOLD NIXDORF, Inc" ;
    sec:hasDisclosure inst:0000028823_BusinessOperations,
        inst:0000028823_CompensationAndBenefits,
        inst:0000028823_CultureAndValues,
        inst:0000028823_DiversityEquityInclusion,
        inst:0000028823_EngagementAndRetention,
        inst:0000028823_Mission,
        inst:0000028823_SafetyAndHealth,
        inst:0000028823_TrainingAndDevelopment,
        inst:0000028823_WorkforceComposition ;
