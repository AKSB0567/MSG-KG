inst:0000007084_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "Archer-Daniels-Midland Co — BusinessOperations" ;
    sec:hasBusinessSegment "Ag Services and Oilseeds",
        "Carbohydrate Solutions",
        "Nutrition" ;
    sec:hasCarbonCapture "Onsite carbon capture and storage facility" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasGovernanceStructure "Board-level Sustainability and Technology Committee; CSO reports to CEO and Board Chair" ;
    sec:hasLogisticsNetwork "Integrated global network of elevators, trucks, railcars, barges, and ships" ;
    sec:hasSECCIK "0000007084" ;
    sec:hasSICCode "FATS & OILS [2070]" ;
    sec:hasSustainabilityGoal "Goal to enroll 5 million regenerative agriculture acres by end of 2025",
        "Increase low-carbon energy to 25% of total; reduce water withdrawal 10%; 90% landfill diversion by 2035",
        "Strive 35: Reduce absolute Scope 1&2 GHG emissions by 25% by 2035 from 2019 baseline",
        "Strive 35: Reduce absolute Scope 3 GHG emissions by 25% by 2035 from 2021 baseline" ;
    sec:hasTechnologyPlatform "Precision fermentation expertise for lubricants, adhesives, home and personal care products" ;
    sec:incorporatedIn inst:jurisdiction_DE ;
    sec:manufacturesProduct "Flour, oils, sweeteners, plant-based meat/dairy, probiotics, enzymes, supplements" ;
    sec:operatesInIndustry inst:industry_Global_agricultural_supply_chain_management_processing_and_nutrition ;
    sec:providesService "Human and animal nutrition with broadest portfolio of ingredients and solutions from nature" .

