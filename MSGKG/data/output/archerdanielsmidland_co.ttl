    rdfs:label "Archer-Daniels-Midland Co — CompensationAndBenefits" ;
    sec:hasCompensationPhilosophy "Market-competitive pay with global rewards including base pay, STI, LTI equity, and PTO" ;
    sec:offersBenefit "Global bonus plan with uniform enterprise metrics for all eligible employees" .

