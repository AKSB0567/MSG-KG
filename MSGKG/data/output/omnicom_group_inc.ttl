inst:0000029989_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "OMNICOM GROUP INC. — BusinessOperations" ;
    sec:hasBrand "Omnicom Advertising Group (OAG) formed August 2024, began operations January 2025",
