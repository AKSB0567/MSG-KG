    sec:hasSECCIK "0000031791" ;
    sec:hasSICCode "3826 - Laboratory Analytical Instruments" ;
    sec:hasSustainabilityProgram "esg.revvity.com for ESG policies; responsible global citizenship and ethical business practices" ;
