    sec:incorporatedIn inst:jurisdiction_MA ;
    sec:manufacturesProduct "Dharmacon reagents and gene modulation technologies (RNAi) for drug discovery",
        "Reagents including radiometric detection, imaging, HTRF, AlphaLISA, AlphaScreen assay technologies" ;
    sec:operatesInIndustry inst:industry_Health_science_solutions_technologies_expertise_and_services ;
    sec:operatesInRegion "Markets products and services in more than 160 countries" ;
    sec:servesCustomerSegment "Pharmaceutical, biotech, contract research organizations, academic and government institutions" .

