inst:0000031791_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "REVVITY, INC. — BusinessOperations" ;
    sec:hasBrand "BioLegend ELISA kits, PhenoVue imaging reagents, PhenoPlate microplates, GrowDex hydrogels" ;
    sec:hasBusinessSegment "Diagnostics",
        "Life Sciences - technologies for drug discovery, development, cell/gene/protein research" ;
