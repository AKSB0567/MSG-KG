inst:0000060519_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "LOUISIANA-PACIFIC CORP — BusinessOperations" ;
    sec:foundedInYear "1972"^^xsd:gYear ;
    sec:hasBrand "LP SmartSide Trim & Siding, LP SmartSide ExpertFinish, LP BuilderSeries Lap Siding, LP Outdoor Building Solutions",
        "LP TechShield, LP WeatherLogic, LP Legacy, LP NovaCore, LP FlameBlock, LP TopNotch 350 (LP Structural Solutions)" ;
