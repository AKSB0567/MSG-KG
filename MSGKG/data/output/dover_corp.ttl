    sec:hasCodeOfConduct "Code of Conduct laying out guidelines for fair and safe workplace" ;
    sec:hasCoreValue "Proactive, dedicated, ownership mindset, commitment to operational excellence" ;
    sec:hasCulturalPillar "High ethical and performance standards valuing accountability, rigor, trust, inclusion, respect" .

inst:0000029905_DiversityEquityInclusion a sec:DiversityEquityInclusion ;
