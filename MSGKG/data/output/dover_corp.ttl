inst:0000029905_BusinessOperations a sec:BusinessOperations ;
    rdfs:label "DOVER Corp — BusinessOperations" ;
    sec:foundedInYear "1947"^^xsd:gYear ;
    sec:hasBusinessSegment "Clean Energy & Fueling - storage, transport, dispensing of traditional and clean fuels",
        "Climate & Sustainability Technologies - commercial refrigeration, heating, cooling, beverage can-making",
        "Engineered Products - vehicle aftermarket, aerospace and defense, industrial equipment",
        "Imaging & Identification - precision marking, coding, product traceability, digital textile printing",
        "Pumps & Process Solutions - specialty pumps, flow meters, polymer processing equipment" ;
    sec:hasCompetitiveDifferentiator "Superior engineering, manufacturing precision, total solution development and supply chain" ;
    sec:hasFacility "India Innovation Center for shared services" ;
    sec:hasFilingPeriod "20241231" ;
    sec:hasKeyFinancialMetric "Sold Environmental Solutions Group (ESG) for $2.0 billion net in October 2024" ;
    sec:hasSECCIK "0000029905" ;
    sec:hasSICCode "3530 - Construction, Mining & Materials Handling Machinery & Equipment" ;
    sec:hasTechnologyPlatform "Dover Digital Labs - software developers, data scientists driving digital transformation" ;
    sec:headquarteredIn inst:location_Downers_Grove_Illinois ;
    sec:incorporatedIn inst:jurisdiction_DE ;
    sec:operatesInIndustry inst:industry_Diversified_global_manufacturing_and_solutions .

