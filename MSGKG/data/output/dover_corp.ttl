    sec:hasVision "Zero-harm workplace with priority on health and safety compliance and risk mitigation" .

inst:0000029905_SafetyAndHealth a sec:SafetyAndHealth ;
    rdfs:label "DOVER Corp — SafetyAndHealth" ;
    sec:hasSafetyMetric "Total recordable injury rate reduced substantially since 2019" ;
    sec:hasSafetyProgram "Global EHS information management system to measure and track health and safety metrics" .

inst:0000029905_TrainingAndDevelopment a sec:TrainingAndDevelopment ;
