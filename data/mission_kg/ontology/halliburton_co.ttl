inst:HALLIBURTON_CO_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:HALLIBURTON_CO_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:HALLIBURTON_CO_Domain_Technology a msg:BusinessDomain ;
    rdfs:label "Technology" .

inst:HALLIBURTON_CO_Domain_Energy a msg:BusinessDomain ;
