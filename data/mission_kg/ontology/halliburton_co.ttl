# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: HALLIBURTON CO
# CIK: 0000045012
# Stakeholders: Customers, Employees, Society
# Values: Innovation, Sustainability, Growth
# Objectives: 0 found
# Domains: Technology, Energy

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_HALLIBURTON_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "HALLIBURTON CO" ;
    msg:cik "0000045012" ;
    msg:sector "1389 - Oil, Gas Field Services, NEC" ;
    msg:hasMission inst:Mission_HALLIBURTON_CO .

# ── Mission Statement ──
inst:Mission_HALLIBURTON_CO a msg:MissionStatement ;
    msg:missionText "We are committed to the continued development of innovative chemical and mechanical technologies that allow for more economical and environment-friendly devel." ;
    msg:extractedFrom "cleaned_10-K_0000045012-25-000010.txt" ;
    msg:servesStakeholder inst:HALLIBURTON_CO_Stakeholder_Customers ;
    msg:servesStakeholder inst:HALLIBURTON_CO_Stakeholder_Employees ;
    msg:servesStakeholder inst:HALLIBURTON_CO_Stakeholder_Society ;
    msg:embodiesValue inst:HALLIBURTON_CO_Value_Innovation ;
    msg:embodiesValue inst:HALLIBURTON_CO_Value_Sustainability ;
    msg:embodiesValue inst:HALLIBURTON_CO_Value_Growth ;
    msg:operatesInDomain inst:HALLIBURTON_CO_Domain_Technology ;
    msg:operatesInDomain inst:HALLIBURTON_CO_Domain_Energy ;
    msg:leveragesCapability inst:HALLIBURTON_CO_Capability_0 ;
    msg:leveragesCapability inst:HALLIBURTON_CO_Capability_1 ;
    msg:leveragesCapability inst:HALLIBURTON_CO_Capability_2  .

inst:HALLIBURTON_CO_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:HALLIBURTON_CO_Stakeholder_Employees a msg:Stakeholder ;
