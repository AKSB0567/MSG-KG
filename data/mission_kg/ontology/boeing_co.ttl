    msg:leveragesCapability inst:BOEING_CO_Capability_0 ;
    msg:leveragesCapability inst:BOEING_CO_Capability_1 ;
    msg:leveragesCapability inst:BOEING_CO_Capability_2 ;
    msg:leveragesCapability inst:BOEING_CO_Capability_3  .

