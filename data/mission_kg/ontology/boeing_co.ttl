# ── Company ──
inst:Company_BOEING_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "BOEING CO" ;
    msg:cik "0000012927" ;
    msg:sector "3721 - Aircraft" ;
    msg:hasMission inst:Mission_BOEING_CO .

# ── Mission Statement ──
inst:Mission_BOEING_CO a msg:MissionStatement ;
