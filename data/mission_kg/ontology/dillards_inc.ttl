@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: DILLARD'S, INC.
# CIK: 0000028917
# Stakeholders: Customers, Employees, Partners
# Values: Growth
# Objectives: 1 found
# Domains: Consumer Goods

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_DILLARD_S_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "DILLARD'S, INC." ;
    msg:cik "0000028917" ;
    msg:sector "5311 - Retail Department Stores" ;
    msg:hasMission inst:Mission_DILLARD_S_INC .

# ── Mission Statement ──
inst:Mission_DILLARD_S_INC a msg:MissionStatement ;
    msg:missionText "We seek to expand the number and use of the private label cards by, among other things, providing incentives to sales associates to encourage customers." ;
    msg:extractedFrom "cleaned_10-K_0000028917-25-000004.txt" ;
    msg:servesStakeholder inst:DILLARD_S_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:DILLARD_S_INC_Stakeholder_Employees ;
    msg:servesStakeholder inst:DILLARD_S_INC_Stakeholder_Partners ;
    msg:embodiesValue inst:DILLARD_S_INC_Value_Growth ;
    msg:pursuesObjective inst:DILLARD_S_INC_Objective_0 ;
    msg:operatesInDomain inst:DILLARD_S_INC_Domain_Consumer_Goods ;
    msg:leveragesCapability inst:DILLARD_S_INC_Capability_0 ;
    msg:leveragesCapability inst:DILLARD_S_INC_Capability_1  .

inst:DILLARD_S_INC_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:DILLARD_S_INC_Stakeholder_Employees a msg:Stakeholder ;
    rdfs:label "Employees" .

inst:DILLARD_S_INC_Stakeholder_Partners a msg:Stakeholder ;
    rdfs:label "Partners" .

inst:DILLARD_S_INC_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:DILLARD_S_INC_Objective_0 a msg:CorporateObjective ;
    rdfs:label "expand the number and use of the private label cards by" .

inst:DILLARD_S_INC_Domain_Consumer_Goods a msg:BusinessDomain ;
    rdfs:label "Consumer Goods" .

inst:DILLARD_S_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Retail operations segment (96% of net sales)" .

inst:DILLARD_S_INC_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Among the nation's largest fashion apparel, cosmetics and home furnishing retailers" .
