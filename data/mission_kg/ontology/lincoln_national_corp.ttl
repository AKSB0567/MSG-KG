# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: LINCOLN NATIONAL CORP
# CIK: 0000059558
# Stakeholders: Customers, Partners
# Values: Safety, Service
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_LINCOLN_NATIONAL_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "LINCOLN NATIONAL CORP" ;
    msg:cik "0000059558" ;
    msg:sector "6311 - Life Insurance" ;
    msg:hasMission inst:Mission_LINCOLN_NATIONAL_CORP .

# ── Mission Statement ──
inst:Mission_LINCOLN_NATIONAL_CORP a msg:MissionStatement ;
    msg:missionText "Provide financial protection and security to customers and families through products and services across four core businesses." ;
    msg:extractedFrom "cleaned_10-K_0000059558-25-000023.txt" ;
    msg:servesStakeholder inst:LINCOLN_NATIONAL_CORP_Stakeholder_Customers ;
    msg:servesStakeholder inst:LINCOLN_NATIONAL_CORP_Stakeholder_Partners ;
    msg:embodiesValue inst:LINCOLN_NATIONAL_CORP_Value_Safety ;
    msg:embodiesValue inst:LINCOLN_NATIONAL_CORP_Value_Service ;
    msg:operatesInDomain inst:LINCOLN_NATIONAL_CORP_Domain_Financial_Services ;
    msg:leveragesCapability inst:LINCOLN_NATIONAL_CORP_Capability_0  .

inst:LINCOLN_NATIONAL_CORP_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:LINCOLN_NATIONAL_CORP_Stakeholder_Partners a msg:Stakeholder ;
    rdfs:label "Partners" .

inst:LINCOLN_NATIONAL_CORP_Value_Safety a msg:CorporateValue ;
    rdfs:label "Safety" .

inst:LINCOLN_NATIONAL_CORP_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:LINCOLN_NATIONAL_CORP_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:LINCOLN_NATIONAL_CORP_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Financial protection and security products across four core businesses" .
