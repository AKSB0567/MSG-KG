# Objectives: 0 found
# Domains: Unknown

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_BRUNSWICK_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "BRUNSWICK CORP" ;
    msg:cik "0000014930" ;
    msg:sector "3510 - Engines & Turbines" ;
    msg:hasMission inst:Mission_BRUNSWICK_CORP .

# ── Mission Statement ──
inst:Mission_BRUNSWICK_CORP a msg:MissionStatement ;
    msg:missionText "Lead industry in ACES strategies and be acknowledged marine sustainability leader; BRUNSWICK CORP — Mission; Expand boating participation through innovative products and shared-access experiences." ;
    msg:extractedFrom "cleaned_10-K_0000014930-25-000025.txt" ;
    msg:servesStakeholder inst:BRUNSWICK_CORP_Stakeholder_Society ;
    msg:servesStakeholder inst:BRUNSWICK_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:BRUNSWICK_CORP_Value_Innovation ;
    msg:embodiesValue inst:BRUNSWICK_CORP_Value_Sustainability ;
    msg:embodiesValue inst:BRUNSWICK_CORP_Value_Growth ;
    msg:leveragesCapability inst:BRUNSWICK_CORP_Capability_0 ;
    msg:leveragesCapability inst:BRUNSWICK_CORP_Capability_1 ;
    msg:leveragesCapability inst:BRUNSWICK_CORP_Capability_2 ;
    msg:leveragesCapability inst:BRUNSWICK_CORP_Capability_3 ;
    msg:leveragesCapability inst:BRUNSWICK_CORP_Capability_4  .

