@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: KIMBERLY CLARK CORP
# CIK: 0000055785
# Stakeholders: Society, Government
# Values: Innovation
# Objectives: 0 found
# Domains: Unknown

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_KIMBERLY_CLARK_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "KIMBERLY CLARK CORP" ;
    msg:cik "0000055785" ;
    msg:sector "2670 - Converted Paper & Paperboard Products" ;
    msg:hasMission inst:Mission_KIMBERLY_CLARK_CORP .

# ── Mission Statement ──
inst:Mission_KIMBERLY_CLARK_CORP a msg:MissionStatement ;
    msg:missionText "KIMBERLY CLARK CORP — Mission; 2024 Transformation Initiative: innovation, margin optimization, organizational agility." ;
    msg:extractedFrom "cleaned_10-K_0000055785-25-000013.txt" ;
    msg:servesStakeholder inst:KIMBERLY_CLARK_CORP_Stakeholder_Society ;
    msg:servesStakeholder inst:KIMBERLY_CLARK_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:KIMBERLY_CLARK_CORP_Value_Innovation ;
    msg:leveragesCapability inst:KIMBERLY_CLARK_CORP_Capability_0 ;
    msg:leveragesCapability inst:KIMBERLY_CLARK_CORP_Capability_1  .

inst:KIMBERLY_CLARK_CORP_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:KIMBERLY_CLARK_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:KIMBERLY_CLARK_CORP_Value_Innovation a msg:CorporateValue ;
    rdfs:label "Innovation" .

inst:KIMBERLY_CLARK_CORP_Capability_0 a msg:BusinessCapability ;
    rdfs:label "International Personal Care (IPC)" .

inst:KIMBERLY_CLARK_CORP_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Baby & Child Care, Adult Care, Feminine Care, Family Care, Professional products" .
