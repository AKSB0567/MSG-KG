# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: EQUIFAX INC
# CIK: 0000033185
# Stakeholders: Government
# Values: Innovation, Integrity, Growth
# Objectives: 1 found
# Domains: Financial Services, Technology, Consumer Goods

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_EQUIFAX_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "EQUIFAX INC" ;
    msg:cik "0000033185" ;
    msg:sector "7320 - Services-Consumer Credit Reporting, Collection Agencies" ;
    msg:hasMission inst:Mission_EQUIFAX_INC .

# ── Mission Statement ──
inst:Mission_EQUIFAX_INC a msg:MissionStatement ;
    msg:missionText "EQUIFAX INC — Mission; To be a trusted global leader in data, analytics and technology creating innovative solutions; Leverage and expand differentiated portfolio of data assets; Leverage Equifax Cloud capabilities to accelerate innovation, new products and growth." ;
    msg:extractedFrom "cleaned_10-K_0000033185-25-000025.txt" ;
    msg:servesStakeholder inst:EQUIFAX_INC_Stakeholder_Government ;
    msg:embodiesValue inst:EQUIFAX_INC_Value_Innovation ;
    msg:embodiesValue inst:EQUIFAX_INC_Value_Integrity ;
    msg:embodiesValue inst:EQUIFAX_INC_Value_Growth ;
    msg:pursuesObjective inst:EQUIFAX_INC_Objective_0 ;
    msg:operatesInDomain inst:EQUIFAX_INC_Domain_Financial_Services ;
    msg:operatesInDomain inst:EQUIFAX_INC_Domain_Technology ;
    msg:operatesInDomain inst:EQUIFAX_INC_Domain_Consumer_Goods ;
    msg:leveragesCapability inst:EQUIFAX_INC_Capability_0 ;
    msg:leveragesCapability inst:EQUIFAX_INC_Capability_1  .

inst:EQUIFAX_INC_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:EQUIFAX_INC_Value_Innovation a msg:CorporateValue ;
    rdfs:label "Innovation" .

inst:EQUIFAX_INC_Value_Integrity a msg:CorporateValue ;
    rdfs:label "Integrity" .

inst:EQUIFAX_INC_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:EQUIFAX_INC_Objective_0 a msg:CorporateObjective ;
    rdfs:label "accelerate innovation" .

inst:EQUIFAX_INC_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:EQUIFAX_INC_Domain_Technology a msg:BusinessDomain ;
    rdfs:label "Technology" .

inst:EQUIFAX_INC_Domain_Consumer_Goods a msg:BusinessDomain ;
    rdfs:label "Consumer Goods" .

inst:EQUIFAX_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "U.S. Information Solutions (USIS) - consumer and commercial information solutions" .

inst:EQUIFAX_INC_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Human resources business process automation and outsourcing services for employers" .
