    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_COCA_COLA_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "COCA COLA CO" ;
    msg:cik "0000021344" ;
    msg:sector "2080 - Beverages" ;
    msg:hasMission inst:Mission_COCA_COLA_CO .

# ── Mission Statement ──
inst:Mission_COCA_COLA_CO a msg:MissionStatement ;
    msg:missionText "For a Better Shared Future - invest to improve people's lives across the business system; COCA COLA CO — Mission; Loved Brands - craft meaningful brands and drinks that people love and enjoy; Done Sustainably - grow business achieving positive change and a more sustainable future." ;
    msg:extractedFrom "cleaned_10-K_0000021344-25-000011.txt" ;
    msg:servesStakeholder inst:COCA_COLA_CO_Stakeholder_Employees ;
    msg:servesStakeholder inst:COCA_COLA_CO_Stakeholder_Government ;
    msg:embodiesValue inst:COCA_COLA_CO_Value_Sustainability ;
    msg:embodiesValue inst:COCA_COLA_CO_Value_Growth ;
    msg:pursuesObjective inst:COCA_COLA_CO_Objective_0 ;
    msg:operatesInDomain inst:COCA_COLA_CO_Domain_Financial_Services ;
    msg:operatesInDomain inst:COCA_COLA_CO_Domain_Consumer_Goods ;
    msg:leveragesCapability inst:COCA_COLA_CO_Capability_0 ;
    msg:leveragesCapability inst:COCA_COLA_CO_Capability_1 ;
    msg:leveragesCapability inst:COCA_COLA_CO_Capability_2 ;
    msg:leveragesCapability inst:COCA_COLA_CO_Capability_3 ;
    msg:leveragesCapability inst:COCA_COLA_CO_Capability_4  .

