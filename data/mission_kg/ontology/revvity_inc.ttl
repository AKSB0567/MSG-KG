    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_REVVITY_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "REVVITY, INC." ;
    msg:cik "0000031791" ;
    msg:sector "3826 - Laboratory Analytical Instruments" ;
    msg:hasMission inst:Mission_REVVITY_INC .

# ── Mission Statement ──
inst:Mission_REVVITY_INC a msg:MissionStatement ;
    msg:missionText "REVVITY, INC. — Mission; Innovation via R&D and acquisitions; operational excellence; expand global offerings." ;
