    msg:embodiesValue inst:REVVITY_INC_Value_Innovation ;
    msg:embodiesValue inst:REVVITY_INC_Value_Excellence ;
    msg:embodiesValue inst:REVVITY_INC_Value_Growth ;
    msg:leveragesCapability inst:REVVITY_INC_Capability_0 ;
