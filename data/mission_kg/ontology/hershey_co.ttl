@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: HERSHEY CO
# CIK: 0000047111
# Stakeholders: Society, Government
# Values: Sustainability
# Objectives: 0 found
# Domains: Unknown

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_HERSHEY_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "HERSHEY CO" ;
    msg:cik "0000047111" ;
    msg:sector "2060 - Sugar & Confectionery Products" ;
    msg:hasMission inst:Mission_HERSHEY_CO .

# ── Mission Statement ──
inst:Mission_HERSHEY_CO a msg:MissionStatement ;
    msg:missionText "HERSHEY CO — Mission; Our Shared Goodness Promise sustainability strategy guiding community and environmental interactions." ;
    msg:extractedFrom "cleaned_10-K_0000047111-25-000014.txt" ;
    msg:servesStakeholder inst:HERSHEY_CO_Stakeholder_Society ;
    msg:servesStakeholder inst:HERSHEY_CO_Stakeholder_Government ;
    msg:embodiesValue inst:HERSHEY_CO_Value_Sustainability ;
    msg:leveragesCapability inst:HERSHEY_CO_Capability_0 ;
    msg:leveragesCapability inst:HERSHEY_CO_Capability_1  .

inst:HERSHEY_CO_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:HERSHEY_CO_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:HERSHEY_CO_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:HERSHEY_CO_Capability_0 a msg:BusinessCapability ;
    rdfs:label "International" .

inst:HERSHEY_CO_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Largest producer of quality chocolate in North America and a leading snack maker in the United State" .
