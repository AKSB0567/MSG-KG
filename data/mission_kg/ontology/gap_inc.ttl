@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: GAP INC
# CIK: 0000039911
# Stakeholders: Customers, Employees, Society, Partners
# Values: Innovation, Sustainability, Service
# Objectives: 0 found
# Domains: Technology, Consumer Goods

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_GAP_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "GAP INC" ;
    msg:cik "0000039911" ;
    msg:sector "5651 - Retail-Family Clothing Stores" ;
    msg:hasMission inst:Mission_GAP_INC .

# ── Mission Statement ──
inst:Mission_GAP_INC a msg:MissionStatement ;
    msg:missionText "We are committed to pursuing technology and product innovation that support our sustainability efforts while also deli." ;
    msg:extractedFrom "cleaned_10-K_0000039911-25-000029.txt" ;
    msg:servesStakeholder inst:GAP_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:GAP_INC_Stakeholder_Employees ;
    msg:servesStakeholder inst:GAP_INC_Stakeholder_Society ;
    msg:servesStakeholder inst:GAP_INC_Stakeholder_Partners ;
    msg:embodiesValue inst:GAP_INC_Value_Innovation ;
    msg:embodiesValue inst:GAP_INC_Value_Sustainability ;
    msg:embodiesValue inst:GAP_INC_Value_Service ;
    msg:operatesInDomain inst:GAP_INC_Domain_Technology ;
    msg:operatesInDomain inst:GAP_INC_Domain_Consumer_Goods  .

inst:GAP_INC_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:GAP_INC_Stakeholder_Employees a msg:Stakeholder ;
    rdfs:label "Employees" .

inst:GAP_INC_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:GAP_INC_Stakeholder_Partners a msg:Stakeholder ;
    rdfs:label "Partners" .

inst:GAP_INC_Value_Innovation a msg:CorporateValue ;
    rdfs:label "Innovation" .

inst:GAP_INC_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:GAP_INC_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:GAP_INC_Domain_Technology a msg:BusinessDomain ;
    rdfs:label "Technology" .

inst:GAP_INC_Domain_Consumer_Goods a msg:BusinessDomain ;
    rdfs:label "Consumer Goods" .
