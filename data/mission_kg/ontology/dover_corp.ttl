@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: DOVER Corp
# CIK: 0000029905
# Stakeholders: Customers, Shareholders, Partners, Government
# Values: Sustainability, Excellence, Safety, Growth
# Objectives: 0 found
# Domains: Healthcare, Manufacturing

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_DOVER_Corp a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "DOVER Corp" ;
    msg:cik "0000029905" ;
    msg:sector "3530 - Construction, Mining & Materials Handling Machinery & Equipment" ;
    msg:hasMission inst:Mission_DOVER_Corp .

# ── Mission Statement ──
inst:Mission_DOVER_Corp a msg:MissionStatement ;
    msg:missionText "Sustained profitable growth, operational excellence, superior free cash flow generation; Zero-harm workplace with priority on health and safety compliance and risk mitigation; DOVER Corp — Mission." ;
    msg:extractedFrom "cleaned_10-K_0000029905-25-000006.txt" ;
    msg:servesStakeholder inst:DOVER_Corp_Stakeholder_Customers ;
    msg:servesStakeholder inst:DOVER_Corp_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:DOVER_Corp_Stakeholder_Partners ;
    msg:servesStakeholder inst:DOVER_Corp_Stakeholder_Government ;
    msg:embodiesValue inst:DOVER_Corp_Value_Sustainability ;
    msg:embodiesValue inst:DOVER_Corp_Value_Excellence ;
    msg:embodiesValue inst:DOVER_Corp_Value_Safety ;
    msg:embodiesValue inst:DOVER_Corp_Value_Growth ;
    msg:operatesInDomain inst:DOVER_Corp_Domain_Healthcare ;
    msg:operatesInDomain inst:DOVER_Corp_Domain_Manufacturing ;
    msg:leveragesCapability inst:DOVER_Corp_Capability_0  .

inst:DOVER_Corp_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:DOVER_Corp_Stakeholder_Shareholders a msg:Stakeholder ;
    rdfs:label "Shareholders" .

inst:DOVER_Corp_Stakeholder_Partners a msg:Stakeholder ;
    rdfs:label "Partners" .

inst:DOVER_Corp_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:DOVER_Corp_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:DOVER_Corp_Value_Excellence a msg:CorporateValue ;
    rdfs:label "Excellence" .

inst:DOVER_Corp_Value_Safety a msg:CorporateValue ;
    rdfs:label "Safety" .

inst:DOVER_Corp_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:DOVER_Corp_Domain_Healthcare a msg:BusinessDomain ;
    rdfs:label "Healthcare" .

inst:DOVER_Corp_Domain_Manufacturing a msg:BusinessDomain ;
    rdfs:label "Manufacturing" .

inst:DOVER_Corp_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Clean Energy & Fueling - storage, transport, dispensing of traditional and clean fuels" .
