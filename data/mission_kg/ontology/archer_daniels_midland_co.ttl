    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_Archer_Daniels_Midland_Co a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "Archer-Daniels-Midland Co" ;
    msg:cik "0000007084" ;
    msg:sector "2070 - Fats & Oils" ;
    msg:hasMission inst:Mission_Archer_Daniels_Midland_Co .

# ── Mission Statement ──
inst:Mission_Archer_Daniels_Midland_Co a msg:MissionStatement ;
