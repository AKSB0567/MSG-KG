# ── Company ──
inst:Company_Howmet_Aerospace_Inc a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "Howmet Aerospace Inc." ;
    msg:cik "0000004281" ;
    msg:sector "3350 - Rolling & Drawing of Nonferrous Metals" ;
