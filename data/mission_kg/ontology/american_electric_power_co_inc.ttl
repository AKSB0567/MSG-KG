    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_AMERICAN_ELECTRIC_POWER_CO_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "AMERICAN ELECTRIC POWER CO INC" ;
    msg:cik "0000004904" ;
    msg:sector "4911 - Electric Services" ;
    msg:hasMission inst:Mission_AMERICAN_ELECTRIC_POWER_CO_INC .

# ── Mission Statement ──
inst:Mission_AMERICAN_ELECTRIC_POWER_CO_INC a msg:MissionStatement ;
    msg:missionText "We are committed to fundamentally embed layers of protection in the work we do." ;
