    msg:servesStakeholder inst:AMERICAN_ELECTRIC_POWER_CO_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:AMERICAN_ELECTRIC_POWER_CO_INC_Stakeholder_Employees ;
    msg:servesStakeholder inst:AMERICAN_ELECTRIC_POWER_CO_INC_Stakeholder_Society ;
    msg:embodiesValue inst:AMERICAN_ELECTRIC_POWER_CO_INC_Value_Safety ;
    msg:operatesInDomain inst:AMERICAN_ELECTRIC_POWER_CO_INC_Domain_Energy ;
    msg:leveragesCapability inst:AMERICAN_ELECTRIC_POWER_CO_INC_Capability_0  .

