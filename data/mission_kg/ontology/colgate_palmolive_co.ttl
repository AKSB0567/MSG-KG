# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: COLGATE PALMOLIVE CO
# CIK: 0000021665
# Stakeholders: Government
# Values: None identified
# Objectives: 0 found
# Domains: Energy

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_COLGATE_PALMOLIVE_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "COLGATE PALMOLIVE CO" ;
    msg:cik "0000021665" ;
    msg:sector "2844 - Perfumes, Cosmetics & Other Toilet Preparations" ;
    msg:hasMission inst:Mission_COLGATE_PALMOLIVE_CO .

# ── Mission Statement ──
inst:Mission_COLGATE_PALMOLIVE_CO a msg:MissionStatement ;
    msg:missionText "COLGATE PALMOLIVE CO — Mission." ;
    msg:extractedFrom "cleaned_10-K_0000021665-25-000008.txt" ;
    msg:servesStakeholder inst:COLGATE_PALMOLIVE_CO_Stakeholder_Government ;
    msg:operatesInDomain inst:COLGATE_PALMOLIVE_CO_Domain_Energy ;
    msg:leveragesCapability inst:COLGATE_PALMOLIVE_CO_Capability_0 ;
    msg:leveragesCapability inst:COLGATE_PALMOLIVE_CO_Capability_1  .

inst:COLGATE_PALMOLIVE_CO_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:COLGATE_PALMOLIVE_CO_Domain_Energy a msg:BusinessDomain ;
    rdfs:label "Energy" .

inst:COLGATE_PALMOLIVE_CO_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Oral, Personal and Home Care" .

inst:COLGATE_PALMOLIVE_CO_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Global leader in liquid hand soap category in Personal Care" .
