# Stakeholders: Customers, Employees, Society, Partners
# Values: Sustainability, Inclusion
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_CINCINNATI_FINANCIAL_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "CINCINNATI FINANCIAL CORP" ;
    msg:cik "0000020286" ;
    msg:sector "6331 - Fire, Marine & Casualty Insurance" ;
    msg:hasMission inst:Mission_CINCINNATI_FINANCIAL_CORP .

# ── Mission Statement ──
inst:Mission_CINCINNATI_FINANCIAL_CORP a msg:MissionStatement ;
    msg:missionText "We are committed to providing equal opportunity for all associates, encouraging a work environment free from unlawful discrimination and harassment." ;
    msg:extractedFrom "cleaned_10-K_0000020286-25-000009.txt" ;
    msg:servesStakeholder inst:CINCINNATI_FINANCIAL_CORP_Stakeholder_Customers ;
    msg:servesStakeholder inst:CINCINNATI_FINANCIAL_CORP_Stakeholder_Employees ;
    msg:servesStakeholder inst:CINCINNATI_FINANCIAL_CORP_Stakeholder_Society ;
    msg:servesStakeholder inst:CINCINNATI_FINANCIAL_CORP_Stakeholder_Partners ;
    msg:embodiesValue inst:CINCINNATI_FINANCIAL_CORP_Value_Sustainability ;
    msg:embodiesValue inst:CINCINNATI_FINANCIAL_CORP_Value_Inclusion ;
    msg:operatesInDomain inst:CINCINNATI_FINANCIAL_CORP_Domain_Financial_Services ;
    msg:leveragesCapability inst:CINCINNATI_FINANCIAL_CORP_Capability_0  .

inst:CINCINNATI_FINANCIAL_CORP_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

