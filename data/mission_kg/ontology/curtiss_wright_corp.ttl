# Stakeholders: Shareholders, Government
# Values: Innovation, Growth
# Objectives: 0 found
# Domains: Financial Services, Manufacturing

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_CURTISS_WRIGHT_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "CURTISS WRIGHT CORP" ;
    msg:cik "0000026324" ;
    msg:sector "3590 - Misc Industrial & Commercial Machinery & Equipment" ;
    msg:hasMission inst:Mission_CURTISS_WRIGHT_CORP .

# ── Mission Statement ──
inst:Mission_CURTISS_WRIGHT_CORP a msg:MissionStatement ;
    msg:missionText "CURTISS WRIGHT CORP — Mission; Disciplined capital allocation: acquisitions, share repurchases and dividends; Operational Growth Platform for margin expansion and steady R&D investment for innovation; Pivot to Growth strategy: maximize revenue, operating income, and free cash flow growth." ;
    msg:extractedFrom "cleaned_10-K_0000026324-25-000015.txt" ;
    msg:servesStakeholder inst:CURTISS_WRIGHT_CORP_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:CURTISS_WRIGHT_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:CURTISS_WRIGHT_CORP_Value_Innovation ;
    msg:embodiesValue inst:CURTISS_WRIGHT_CORP_Value_Growth ;
    msg:operatesInDomain inst:CURTISS_WRIGHT_CORP_Domain_Financial_Services ;
    msg:operatesInDomain inst:CURTISS_WRIGHT_CORP_Domain_Manufacturing ;
    msg:leveragesCapability inst:CURTISS_WRIGHT_CORP_Capability_0  .

inst:CURTISS_WRIGHT_CORP_Stakeholder_Shareholders a msg:Stakeholder ;
    rdfs:label "Shareholders" .

inst:CURTISS_WRIGHT_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:CURTISS_WRIGHT_CORP_Value_Innovation a msg:CorporateValue ;
    rdfs:label "Innovation" .

inst:CURTISS_WRIGHT_CORP_Value_Growth a msg:CorporateValue ;
