    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_GENUINE_PARTS_CO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "GENUINE PARTS CO" ;
    msg:cik "0000040987" ;
    msg:sector "5013 - Wholesale Motor Vehicle Supplies & New Parts" ;
    msg:hasMission inst:Mission_GENUINE_PARTS_CO .

# ── Mission Statement ──
inst:Mission_GENUINE_PARTS_CO a msg:MissionStatement ;
    msg:missionText "Employer of choice, supplier of choice, valued customer, responsible corporate citizen, investment of choice." ;
    msg:extractedFrom "cleaned_10-K_0000040987-25-000026.txt" ;
    msg:servesStakeholder inst:GENUINE_PARTS_CO_Stakeholder_Customers ;
    msg:servesStakeholder inst:GENUINE_PARTS_CO_Stakeholder_Employees ;
    msg:servesStakeholder inst:GENUINE_PARTS_CO_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:GENUINE_PARTS_CO_Stakeholder_Partners ;
    msg:operatesInDomain inst:GENUINE_PARTS_CO_Domain_Financial_Services ;
    msg:leveragesCapability inst:GENUINE_PARTS_CO_Capability_0  .

inst:GENUINE_PARTS_CO_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:GENUINE_PARTS_CO_Stakeholder_Employees a msg:Stakeholder ;
    rdfs:label "Employees" .

