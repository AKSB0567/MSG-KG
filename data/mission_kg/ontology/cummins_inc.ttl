    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_CUMMINS_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "CUMMINS INC" ;
    msg:cik "0000026172" ;
    msg:sector "3510 - Engines & Turbines" ;
    msg:hasMission inst:Mission_CUMMINS_INC .

# ── Mission Statement ──
inst:Mission_CUMMINS_INC a msg:MissionStatement ;
    msg:missionText "We do this through our commitment to fostering an accountable culture that champions our vision of a workforce mirroring the communities we serve. This commitment starts at the top with our Board and permeates throughout our organization as everyone plays a role in nurturing inclusive environments where all employees can reach their full potential and thrive." ;
    msg:extractedFrom "cleaned_10-K_0000026172-25-000007.txt" ;
    msg:servesStakeholder inst:CUMMINS_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:CUMMINS_INC_Stakeholder_Employees ;
    msg:servesStakeholder inst:CUMMINS_INC_Stakeholder_Society ;
    msg:servesStakeholder inst:CUMMINS_INC_Stakeholder_Government ;
    msg:embodiesValue inst:CUMMINS_INC_Value_Sustainability ;
    msg:embodiesValue inst:CUMMINS_INC_Value_Integrity ;
    msg:embodiesValue inst:CUMMINS_INC_Value_Inclusion ;
    msg:embodiesValue inst:CUMMINS_INC_Value_Service ;
    msg:leveragesCapability inst:CUMMINS_INC_Capability_0 ;
    msg:leveragesCapability inst:CUMMINS_INC_Capability_1 ;
    msg:leveragesCapability inst:CUMMINS_INC_Capability_2  .

