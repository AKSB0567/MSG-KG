@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: TARGET CORP
# CIK: 0000027419
# Stakeholders: Government
# Values: Service
# Objectives: 0 found
# Domains: Consumer Goods

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_TARGET_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "TARGET CORP" ;
    msg:cik "0000027419" ;
    msg:sector "5331 - Retail-Variety Stores" ;
    msg:hasMission inst:Mission_TARGET_CORP .

# ── Mission Statement ──
inst:Mission_TARGET_CORP a msg:MissionStatement ;
    msg:missionText "TARGET CORP — Mission; Delight with newness, style and value; strengthen owned brands and curate leading national brands; Everyday low pricing, promotions and Target Circle loyalty ecosystem for delivering value." ;
    msg:extractedFrom "cleaned_10-K_0000027419-25-000018.txt" ;
    msg:servesStakeholder inst:TARGET_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:TARGET_CORP_Value_Service ;
    msg:operatesInDomain inst:TARGET_CORP_Domain_Consumer_Goods  .

inst:TARGET_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:TARGET_CORP_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:TARGET_CORP_Domain_Consumer_Goods a msg:BusinessDomain ;
    rdfs:label "Consumer Goods" .
