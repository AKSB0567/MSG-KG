# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_COMMERCE_BANCSHARES_INC_MO a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "COMMERCE BANCSHARES INC /MO/" ;
    msg:cik "0000022356" ;
    msg:sector "6022 - State Commercial Banks" ;
    msg:hasMission inst:Mission_COMMERCE_BANCSHARES_INC_MO .

# ── Mission Statement ──
inst:Mission_COMMERCE_BANCSHARES_INC_MO a msg:MissionStatement ;
    msg:missionText "And its subsidiaries (collectively, the \"Company\") is one of the nation’s top 50 bank holding companies, based on asset size." ;
    msg:extractedFrom "cleaned_10-K_0000022356-25-000016.txt" ;
    msg:operatesInDomain inst:COMMERCE_BANCSHARES_INC_MO_Domain_Financial_Services ;
    msg:leveragesCapability inst:COMMERCE_BANCSHARES_INC_MO_Capability_0 ;
    msg:leveragesCapability inst:COMMERCE_BANCSHARES_INC_MO_Capability_1 ;
    msg:leveragesCapability inst:COMMERCE_BANCSHARES_INC_MO_Capability_2  .

inst:COMMERCE_BANCSHARES_INC_MO_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:COMMERCE_BANCSHARES_INC_MO_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Consumer" .

inst:COMMERCE_BANCSHARES_INC_MO_Capability_1 a msg:BusinessCapability ;
    rdfs:label "General banking, retail, mortgage, corporate, investment, trust, asset management, securities broker" .

inst:COMMERCE_BANCSHARES_INC_MO_Capability_2 a msg:BusinessCapability ;
    rdfs:label "One of the nation's top 50 bank holding companies based on asset size" .
