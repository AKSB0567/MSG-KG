@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: HASBRO, INC.
# CIK: 0000046080
# Stakeholders: Customers, Society, Partners
# Values: None identified
# Objectives: 0 found
# Domains: Unknown

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_HASBRO_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "HASBRO, INC." ;
    msg:cik "0000046080" ;
    msg:sector "3944 - Games, Toys & Children's Vehicles" ;
    msg:hasMission inst:Mission_HASBRO_INC .

# ── Mission Statement ──
inst:Mission_HASBRO_INC a msg:MissionStatement ;
    msg:missionText "Create joy and community through the magic of play." ;
    msg:extractedFrom "cleaned_10-K_0000046080-25-000027.txt" ;
    msg:servesStakeholder inst:HASBRO_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:HASBRO_INC_Stakeholder_Society ;
    msg:servesStakeholder inst:HASBRO_INC_Stakeholder_Partners ;
    msg:leveragesCapability inst:HASBRO_INC_Capability_0  .

inst:HASBRO_INC_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:HASBRO_INC_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:HASBRO_INC_Stakeholder_Partners a msg:Stakeholder ;
    rdfs:label "Partners" .

inst:HASBRO_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Wizards of the Coast and Digital Games" .
