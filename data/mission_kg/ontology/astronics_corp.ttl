@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: ASTRONICS CORP
# CIK: 0000008063
# Stakeholders: Government
# Values: Growth
# Objectives: 0 found
# Domains: Technology, Manufacturing, Aerospace & Defense

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_ASTRONICS_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "ASTRONICS CORP" ;
    msg:cik "0000008063" ;
    msg:sector "3728 - Aircraft Part & Auxiliary Equipment, NEC" ;
    msg:hasMission inst:Mission_ASTRONICS_CORP .

# ── Mission Statement ──
inst:Mission_ASTRONICS_CORP a msg:MissionStatement ;
    msg:missionText "Increase value by developing technologies internally or through acquisition for targeted markets; ASTRONICS CORP — Mission." ;
    msg:extractedFrom "cleaned_10-K_0000008063-25-000017.txt" ;
    msg:servesStakeholder inst:ASTRONICS_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:ASTRONICS_CORP_Value_Growth ;
    msg:operatesInDomain inst:ASTRONICS_CORP_Domain_Technology ;
    msg:operatesInDomain inst:ASTRONICS_CORP_Domain_Manufacturing ;
    msg:operatesInDomain inst:ASTRONICS_CORP_Domain_Aerospace_Defense ;
    msg:leveragesCapability inst:ASTRONICS_CORP_Capability_0 ;
    msg:leveragesCapability inst:ASTRONICS_CORP_Capability_1  .

inst:ASTRONICS_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:ASTRONICS_CORP_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:ASTRONICS_CORP_Domain_Technology a msg:BusinessDomain ;
    rdfs:label "Technology" .

inst:ASTRONICS_CORP_Domain_Manufacturing a msg:BusinessDomain ;
    rdfs:label "Manufacturing" .

inst:ASTRONICS_CORP_Domain_Aerospace_Defense a msg:BusinessDomain ;
    rdfs:label "Aerospace & Defense" .

inst:ASTRONICS_CORP_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Test Systems segment - automated test systems for aerospace, defense, communications, mass transit" .

inst:ASTRONICS_CORP_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Avionics products, aircraft structures and automated test systems" .
