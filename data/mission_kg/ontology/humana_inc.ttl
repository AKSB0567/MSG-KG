# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: HUMANA INC
# CIK: 0000049071
# Stakeholders: Customers, Society, Government
# Values: Excellence, Service
# Objectives: 0 found
# Domains: Technology, Healthcare

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_HUMANA_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "HUMANA INC" ;
    msg:cik "0000049071" ;
    msg:sector "6324 - Hospital & Medical Service Plans" ;
    msg:hasMission inst:Mission_HUMANA_INC .

# ── Mission Statement ──
inst:Mission_HUMANA_INC a msg:MissionStatement ;
    msg:missionText "HUMANA INC — Mission; Integrated care delivery model uniting quality care, high member engagement, and sophisticated data analytics." ;
    msg:extractedFrom "cleaned_10-K_0000049071-25-000007.txt" ;
    msg:servesStakeholder inst:HUMANA_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:HUMANA_INC_Stakeholder_Society ;
    msg:servesStakeholder inst:HUMANA_INC_Stakeholder_Government ;
    msg:embodiesValue inst:HUMANA_INC_Value_Excellence ;
    msg:embodiesValue inst:HUMANA_INC_Value_Service ;
    msg:operatesInDomain inst:HUMANA_INC_Domain_Technology ;
    msg:operatesInDomain inst:HUMANA_INC_Domain_Healthcare ;
    msg:leveragesCapability inst:HUMANA_INC_Capability_0 ;
    msg:leveragesCapability inst:HUMANA_INC_Capability_1  .

inst:HUMANA_INC_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:HUMANA_INC_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:HUMANA_INC_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:HUMANA_INC_Value_Excellence a msg:CorporateValue ;
    rdfs:label "Excellence" .

inst:HUMANA_INC_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:HUMANA_INC_Domain_Technology a msg:BusinessDomain ;
    rdfs:label "Technology" .

inst:HUMANA_INC_Domain_Healthcare a msg:BusinessDomain ;
