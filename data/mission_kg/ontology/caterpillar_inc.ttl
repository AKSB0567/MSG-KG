@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: CATERPILLAR INC
# CIK: 0000018230
# Stakeholders: Customers, Society
# Values: Sustainability, Excellence, Growth, Service
# Objectives: 0 found
# Domains: Manufacturing

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_CATERPILLAR_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "CATERPILLAR INC" ;
    msg:cik "0000018230" ;
    msg:sector "3531 - Construction Machinery & Equipment" ;
    msg:hasMission inst:Mission_CATERPILLAR_INC .

# ── Mission Statement ──
inst:Mission_CATERPILLAR_INC a msg:MissionStatement ;
    msg:missionText "Help customers build a better, more sustainable world; Expanded Offerings, Operational Excellence, Services, and Sustainability; CATERPILLAR INC — Mission." ;
    msg:extractedFrom "cleaned_10-K_0000018230-25-000008.txt" ;
    msg:servesStakeholder inst:CATERPILLAR_INC_Stakeholder_Customers ;
    msg:servesStakeholder inst:CATERPILLAR_INC_Stakeholder_Society ;
    msg:embodiesValue inst:CATERPILLAR_INC_Value_Sustainability ;
    msg:embodiesValue inst:CATERPILLAR_INC_Value_Excellence ;
    msg:embodiesValue inst:CATERPILLAR_INC_Value_Growth ;
    msg:embodiesValue inst:CATERPILLAR_INC_Value_Service ;
    msg:operatesInDomain inst:CATERPILLAR_INC_Domain_Manufacturing ;
    msg:leveragesCapability inst:CATERPILLAR_INC_Capability_0 ;
    msg:leveragesCapability inst:CATERPILLAR_INC_Capability_1 ;
    msg:leveragesCapability inst:CATERPILLAR_INC_Capability_2  .

inst:CATERPILLAR_INC_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:CATERPILLAR_INC_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:CATERPILLAR_INC_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:CATERPILLAR_INC_Value_Excellence a msg:CorporateValue ;
    rdfs:label "Excellence" .

inst:CATERPILLAR_INC_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:CATERPILLAR_INC_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:CATERPILLAR_INC_Domain_Manufacturing a msg:BusinessDomain ;
    rdfs:label "Manufacturing" .

inst:CATERPILLAR_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Energy & Transportation" .

inst:CATERPILLAR_INC_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Construction/mining equipment, off-highway diesel/natural gas engines, gas turbines, locomotives" .

inst:CATERPILLAR_INC_Capability_2 a msg:BusinessCapability ;
    rdfs:label "World's leading manufacturer of construction and mining equipment" .
