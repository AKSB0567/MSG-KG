@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: US BANCORP \DE\
# CIK: 0000036104
# Stakeholders: Customers, Shareholders, Government
# Values: Service
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_US_BANCORP_DE a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "US BANCORP \\DE\\" ;
    msg:cik "0000036104" ;
    msg:sector "6021 - National Commercial Banks" ;
    msg:hasMission inst:Mission_US_BANCORP_DE .

# ── Mission Statement ──
inst:Mission_US_BANCORP_DE a msg:MissionStatement ;
    msg:missionText "USBNA provides a wide range of products and services to individua." ;
    msg:extractedFrom "cleaned_10-K_0000036104-25-000016.txt" ;
    msg:servesStakeholder inst:US_BANCORP_DE_Stakeholder_Customers ;
    msg:servesStakeholder inst:US_BANCORP_DE_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:US_BANCORP_DE_Stakeholder_Government ;
    msg:embodiesValue inst:US_BANCORP_DE_Value_Service ;
    msg:operatesInDomain inst:US_BANCORP_DE_Domain_Financial_Services  .

inst:US_BANCORP_DE_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:US_BANCORP_DE_Stakeholder_Shareholders a msg:Stakeholder ;
    rdfs:label "Shareholders" .

inst:US_BANCORP_DE_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:US_BANCORP_DE_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:US_BANCORP_DE_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .
