inst:FLOWSERVE_CORP_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Pumps, valves, seals, automation and aftermarket services" .

inst:FLOWSERVE_CORP_Capability_2 a msg:BusinessCapability ;
    rdfs:label "World-leading manufacturer and aftermarket service provider of flow control systems" .
