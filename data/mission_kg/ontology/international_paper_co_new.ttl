    msg:servesStakeholder inst:INTERNATIONAL_PAPER_CO_NEW_Stakeholder_Employees ;
    msg:embodiesValue inst:INTERNATIONAL_PAPER_CO_NEW_Value_Growth ;
    msg:pursuesObjective inst:INTERNATIONAL_PAPER_CO_NEW_Objective_0  .

inst:INTERNATIONAL_PAPER_CO_NEW_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:INTERNATIONAL_PAPER_CO_NEW_Stakeholder_Employees a msg:Stakeholder ;
    rdfs:label "Employees" .

inst:INTERNATIONAL_PAPER_CO_NEW_Value_Growth a msg:CorporateValue ;
