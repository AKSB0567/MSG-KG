    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_INTERNATIONAL_PAPER_CO_NEW a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "INTERNATIONAL PAPER CO /NEW/" ;
    msg:cik "0000051434" ;
    msg:sector "2621 - Paper Mills" ;
    msg:hasMission inst:Mission_INTERNATIONAL_PAPER_CO_NEW .

# ── Mission Statement ──
inst:Mission_INTERNATIONAL_PAPER_CO_NEW a msg:MissionStatement ;
    msg:missionText "Results of the survey will be analyzed in 2025 with the goal of learning, growing and aspiring to achieve our Vision 2030 goal to create a 100% injury-free workplace for our t." ;
