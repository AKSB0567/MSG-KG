@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: LOWES COMPANIES INC
# CIK: 0000060667
# Stakeholders: Government
# Values: Growth, Service
# Objectives: 0 found
# Domains: Aerospace & Defense

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_LOWES_COMPANIES_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "LOWES COMPANIES INC" ;
    msg:cik "0000060667" ;
    msg:sector "5211 - Lumber & Building Materials Dealers" ;
    msg:hasMission inst:Mission_LOWES_COMPANIES_INC .

# ── Mission Statement ──
inst:Mission_LOWES_COMPANIES_INC a msg:MissionStatement ;
    msg:missionText "Create a loyalty ecosystem (MyLowe's Rewards); Expand home services; Drive Pro penetration; LOWES COMPANIES INC — Mission; Increase space productivity; Accelerate online sales." ;
    msg:extractedFrom "cleaned_10-K_0000060667-25-000049.txt" ;
    msg:servesStakeholder inst:LOWES_COMPANIES_INC_Stakeholder_Government ;
    msg:embodiesValue inst:LOWES_COMPANIES_INC_Value_Growth ;
    msg:embodiesValue inst:LOWES_COMPANIES_INC_Value_Service ;
    msg:operatesInDomain inst:LOWES_COMPANIES_INC_Domain_Aerospace_Defense ;
    msg:leveragesCapability inst:LOWES_COMPANIES_INC_Capability_0  .

inst:LOWES_COMPANIES_INC_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:LOWES_COMPANIES_INC_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:LOWES_COMPANIES_INC_Value_Service a msg:CorporateValue ;
    rdfs:label "Service" .

inst:LOWES_COMPANIES_INC_Domain_Aerospace_Defense a msg:BusinessDomain ;
    rdfs:label "Aerospace & Defense" .

inst:LOWES_COMPANIES_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Fortune 50 company and world's second largest home improvement retailer" .
