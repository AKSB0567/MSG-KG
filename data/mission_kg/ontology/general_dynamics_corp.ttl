@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: GENERAL DYNAMICS CORP
# CIK: 0000040533
# Stakeholders: Customers, Shareholders, Society, Government
# Values: Safety
# Objectives: 1 found
# Domains: Financial Services, Aerospace & Defense

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_GENERAL_DYNAMICS_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "GENERAL DYNAMICS CORP" ;
    msg:cik "0000040533" ;
    msg:sector "3730 - Ship & Boat Building & Repairing" ;
    msg:hasMission inst:Mission_GENERAL_DYNAMICS_CORP .

# ── Mission Statement ──
inst:Mission_GENERAL_DYNAMICS_CORP a msg:MissionStatement ;
    msg:missionText "We are committed to continual investment in R&D to create new aircraft that consistently broaden customer offerings while raising the bar for safety and performance." ;
    msg:extractedFrom "cleaned_10-K_0000040533-25-000008.txt" ;
    msg:servesStakeholder inst:GENERAL_DYNAMICS_CORP_Stakeholder_Customers ;
    msg:servesStakeholder inst:GENERAL_DYNAMICS_CORP_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:GENERAL_DYNAMICS_CORP_Stakeholder_Society ;
    msg:servesStakeholder inst:GENERAL_DYNAMICS_CORP_Stakeholder_Government ;
    msg:embodiesValue inst:GENERAL_DYNAMICS_CORP_Value_Safety ;
    msg:pursuesObjective inst:GENERAL_DYNAMICS_CORP_Objective_0 ;
    msg:operatesInDomain inst:GENERAL_DYNAMICS_CORP_Domain_Financial_Services ;
    msg:operatesInDomain inst:GENERAL_DYNAMICS_CORP_Domain_Aerospace_Defense ;
    msg:leveragesCapability inst:GENERAL_DYNAMICS_CORP_Capability_0 ;
    msg:leveragesCapability inst:GENERAL_DYNAMICS_CORP_Capability_1 ;
    msg:leveragesCapability inst:GENERAL_DYNAMICS_CORP_Capability_2  .

inst:GENERAL_DYNAMICS_CORP_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:GENERAL_DYNAMICS_CORP_Stakeholder_Shareholders a msg:Stakeholder ;
    rdfs:label "Shareholders" .

inst:GENERAL_DYNAMICS_CORP_Stakeholder_Society a msg:Stakeholder ;
    rdfs:label "Society" .

inst:GENERAL_DYNAMICS_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:GENERAL_DYNAMICS_CORP_Value_Safety a msg:CorporateValue ;
    rdfs:label "Safety" .

inst:GENERAL_DYNAMICS_CORP_Objective_0 a msg:CorporateObjective ;
    rdfs:label "create new aircraft that consistently broaden customer offerings while raising the bar" .

inst:GENERAL_DYNAMICS_CORP_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:GENERAL_DYNAMICS_CORP_Domain_Aerospace_Defense a msg:BusinessDomain ;
    rdfs:label "Aerospace & Defense" .

inst:GENERAL_DYNAMICS_CORP_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Marine Systems" .

inst:GENERAL_DYNAMICS_CORP_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Technology products and services for defense customers" .

inst:GENERAL_DYNAMICS_CORP_Capability_2 a msg:BusinessCapability ;
