# Domains: Manufacturing

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_INTERNATIONAL_BUSINESS_MACHINES_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "INTERNATIONAL BUSINESS MACHINES CORP" ;
    msg:cik "0000051143" ;
    msg:sector "3570 - Computer & Office Equipment" ;
    msg:hasMission inst:Mission_INTERNATIONAL_BUSINESS_MACHINES_CORP .

# ── Mission Statement ──
inst:Mission_INTERNATIONAL_BUSINESS_MACHINES_CORP a msg:MissionStatement ;
    msg:missionText "Competition IBM is a globally in." ;
    msg:extractedFrom "cleaned_10-K_0000051143-25-000015.txt" ;
    msg:servesStakeholder inst:INTERNATIONAL_BUSINESS_MACHINES_CORP_Stakeholder_Customers ;
    msg:operatesInDomain inst:INTERNATIONAL_BUSINESS_MACHINES_CORP_Domain_Manufacturing  .

