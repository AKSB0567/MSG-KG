@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: ASSOCIATED BANC-CORP
# CIK: 0000007789
# Stakeholders: Customers, Employees
# Values: Growth
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_ASSOCIATED_BANC_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "ASSOCIATED BANC-CORP" ;
    msg:cik "0000007789" ;
    msg:sector "6022 - State Commercial Banks" ;
    msg:hasMission inst:Mission_ASSOCIATED_BANC_CORP .

# ── Mission Statement ──
inst:Mission_ASSOCIATED_BANC_CORP a msg:MissionStatement ;
    msg:missionText "Profitable growth strategy including managing loan/deposit growth and retaining employees; ASSOCIATED BANC-CORP — Mission." ;
    msg:extractedFrom "cleaned_10-K_0000007789-25-000013.txt" ;
    msg:servesStakeholder inst:ASSOCIATED_BANC_CORP_Stakeholder_Customers ;
    msg:servesStakeholder inst:ASSOCIATED_BANC_CORP_Stakeholder_Employees ;
    msg:embodiesValue inst:ASSOCIATED_BANC_CORP_Value_Growth ;
    msg:operatesInDomain inst:ASSOCIATED_BANC_CORP_Domain_Financial_Services  .

inst:ASSOCIATED_BANC_CORP_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:ASSOCIATED_BANC_CORP_Stakeholder_Employees a msg:Stakeholder ;
    rdfs:label "Employees" .

inst:ASSOCIATED_BANC_CORP_Value_Growth a msg:CorporateValue ;
    rdfs:label "Growth" .

inst:ASSOCIATED_BANC_CORP_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .
