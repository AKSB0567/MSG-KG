inst:Mission_BERKLEY_W_R_CORP a msg:MissionStatement ;
    msg:missionText "Reinsurance & Monoline Excess We provide other insurance companies and self-insureds with assistance in managing their net risk through reinsurance on either a portfolio basis, through treaty reinsurance, or on an individual basis, through." ;
