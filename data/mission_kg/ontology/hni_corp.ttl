# ── Company ──
inst:Company_HNI_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "HNI CORP" ;
    msg:cik "0000048287" ;
    msg:sector "2522 - Office Furniture (Except Wood)" ;
    msg:hasMission inst:Mission_HNI_CORP .

# ── Mission Statement ──
inst:Mission_HNI_CORP a msg:MissionStatement ;
    msg:missionText "Business General HNI Corporation is a leading global designer and provider of commercial furnishings, and a leading manufacturer and marketer of hearth products." ;
    msg:extractedFrom "cleaned_10-K_0000048287-25-000084.txt" ;
    msg:servesStakeholder inst:HNI_CORP_Stakeholder_Customers ;
    msg:operatesInDomain inst:HNI_CORP_Domain_Manufacturing ;
    msg:leveragesCapability inst:HNI_CORP_Capability_0 ;
    msg:leveragesCapability inst:HNI_CORP_Capability_1 ;
    msg:leveragesCapability inst:HNI_CORP_Capability_2 ;
    msg:leveragesCapability inst:HNI_CORP_Capability_3  .

