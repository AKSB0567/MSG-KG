# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: RAYONIER INC
# CIK: 0000052827
# Stakeholders: Government
# Values: Sustainability, Excellence
# Objectives: 0 found
# Domains: Financial Services, Real Estate

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_RAYONIER_INC a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "RAYONIER INC" ;
    msg:cik "0000052827" ;
    msg:sector "6798 - Real Estate Investment Trusts" ;
    msg:hasMission inst:Mission_RAYONIER_INC .

# ── Mission Statement ──
inst:Mission_RAYONIER_INC a msg:MissionStatement ;
    msg:missionText "RAYONIER INC — Mission; Own high-quality timberlands managed with long-term sustainable yield strategy; Active portfolio management through selective acquisitions and dispositions." ;
    msg:extractedFrom "cleaned_10-K_0000052827-25-000018.txt" ;
    msg:servesStakeholder inst:RAYONIER_INC_Stakeholder_Government ;
    msg:embodiesValue inst:RAYONIER_INC_Value_Sustainability ;
    msg:embodiesValue inst:RAYONIER_INC_Value_Excellence ;
    msg:operatesInDomain inst:RAYONIER_INC_Domain_Financial_Services ;
    msg:operatesInDomain inst:RAYONIER_INC_Domain_Real_Estate ;
    msg:leveragesCapability inst:RAYONIER_INC_Capability_0 ;
    msg:leveragesCapability inst:RAYONIER_INC_Capability_1  .

inst:RAYONIER_INC_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:RAYONIER_INC_Value_Sustainability a msg:CorporateValue ;
    rdfs:label "Sustainability" .

inst:RAYONIER_INC_Value_Excellence a msg:CorporateValue ;
    rdfs:label "Excellence" .

inst:RAYONIER_INC_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:RAYONIER_INC_Domain_Real_Estate a msg:BusinessDomain ;
    rdfs:label "Real Estate" .

inst:RAYONIER_INC_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Real Estate" .

inst:RAYONIER_INC_Capability_1 a msg:BusinessCapability ;
    rdfs:label "Strategic location in core softwood producing regions with favorable supply-demand" .
