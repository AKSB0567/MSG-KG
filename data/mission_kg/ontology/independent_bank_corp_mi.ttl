# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: INDEPENDENT BANK CORP /MI/
# CIK: 0000039311
# Stakeholders: Government
# Values: None identified
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_INDEPENDENT_BANK_CORP_MI a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "INDEPENDENT BANK CORP /MI/" ;
    msg:cik "0000039311" ;
    msg:sector "6022 - State Commercial Banks" ;
    msg:hasMission inst:Mission_INDEPENDENT_BANK_CORP_MI .

# ── Mission Statement ──
inst:Mission_INDEPENDENT_BANK_CORP_MI a msg:MissionStatement ;
    msg:missionText "We seek to limit credit losses in our securities portfolios by principally purchasing highly rated securities (generally rated \"AA\" or higher by a major debt rating a." ;
    msg:extractedFrom "cleaned_10-K_0000039311-25-000044.txt" ;
    msg:servesStakeholder inst:INDEPENDENT_BANK_CORP_MI_Stakeholder_Government ;
    msg:operatesInDomain inst:INDEPENDENT_BANK_CORP_MI_Domain_Financial_Services ;
    msg:leveragesCapability inst:INDEPENDENT_BANK_CORP_MI_Capability_0  .

inst:INDEPENDENT_BANK_CORP_MI_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:INDEPENDENT_BANK_CORP_MI_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .

inst:INDEPENDENT_BANK_CORP_MI_Capability_0 a msg:BusinessCapability ;
    rdfs:label "Title insurance services" .
