    rdfs:label "Shareholders" .

inst:DMC_Global_Inc_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:DMC_Global_Inc_Domain_Financial_Services a msg:BusinessDomain ;
