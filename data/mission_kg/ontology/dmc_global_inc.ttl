    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_DMC_Global_Inc a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "DMC Global Inc." ;
    msg:cik "0000034067" ;
    msg:sector "3390 - Miscellaneous Primary Metal Products" ;
    msg:hasMission inst:Mission_DMC_Global_Inc .

# ── Mission Statement ──
inst:Mission_DMC_Global_Inc a msg:MissionStatement ;
    msg:missionText "DMC Global Inc. — Mission; Maximize company value by capitalizing on unique strengths of three businesses." ;
    msg:extractedFrom "cleaned_10-K_0000034067-25-000028.txt" ;
    msg:servesStakeholder inst:DMC_Global_Inc_Stakeholder_Shareholders ;
    msg:servesStakeholder inst:DMC_Global_Inc_Stakeholder_Government ;
    msg:operatesInDomain inst:DMC_Global_Inc_Domain_Financial_Services ;
    msg:leveragesCapability inst:DMC_Global_Inc_Capability_0 ;
    msg:leveragesCapability inst:DMC_Global_Inc_Capability_1  .

