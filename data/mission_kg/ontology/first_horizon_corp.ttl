@prefix msg: <http://msgkg.io/ontology#> .
@prefix fibo-fnd: <https://spec.edmcouncil.org/fibo/ontology/FND/> .
@prefix fibo-be: <https://spec.edmcouncil.org/fibo/ontology/BE/> .
@prefix inst: <http://msgkg.io/instances#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology Schema: FIBO-Aligned Mission Decomposition ──
# Company: FIRST HORIZON CORP
# CIK: 0000036966
# Stakeholders: Customers, Government
# Values: None identified
# Objectives: 0 found
# Domains: Financial Services

# ── Class Definitions ──
msg:MissionStatement a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Mission Statement" .
msg:Stakeholder a owl:Class ;
    rdfs:subClassOf fibo-be:LegalEntity ;
    rdfs:label "Stakeholder" .
msg:CorporateObjective a owl:Class ;
    rdfs:subClassOf fibo-fnd:BusinessObjective ;
    rdfs:label "Corporate Objective" .
msg:CorporateValue a owl:Class ;
    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_FIRST_HORIZON_CORP a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "FIRST HORIZON CORP" ;
    msg:cik "0000036966" ;
    msg:sector "6021 - National Commercial Banks" ;
    msg:hasMission inst:Mission_FIRST_HORIZON_CORP .

# ── Mission Statement ──
inst:Mission_FIRST_HORIZON_CORP a msg:MissionStatement ;
    msg:missionText "Our principal businesses are heavily regulated." ;
    msg:extractedFrom "cleaned_10-K_0000036966-25-000024.txt" ;
    msg:servesStakeholder inst:FIRST_HORIZON_CORP_Stakeholder_Customers ;
    msg:servesStakeholder inst:FIRST_HORIZON_CORP_Stakeholder_Government ;
    msg:operatesInDomain inst:FIRST_HORIZON_CORP_Domain_Financial_Services  .

inst:FIRST_HORIZON_CORP_Stakeholder_Customers a msg:Stakeholder ;
    rdfs:label "Customers" .

inst:FIRST_HORIZON_CORP_Stakeholder_Government a msg:Stakeholder ;
    rdfs:label "Government" .

inst:FIRST_HORIZON_CORP_Domain_Financial_Services a msg:BusinessDomain ;
    rdfs:label "Financial Services" .
