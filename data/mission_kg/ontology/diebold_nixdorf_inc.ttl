    rdfs:label "Corporate Value" .
msg:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability" .
msg:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" .

# ── Company ──
inst:Company_DIEBOLD_NIXDORF_Inc a msg:Company, fibo-be:LegalEntity ;
    rdfs:label "DIEBOLD NIXDORF, Inc" ;
    msg:cik "0000028823" ;
    msg:sector "3578 - Calculating & Accounting Machines (No Electronic Computers)" ;
    msg:hasMission inst:Mission_DIEBOLD_NIXDORF_Inc .

# ── Mission Statement ──
inst:Mission_DIEBOLD_NIXDORF_Inc a msg:MissionStatement ;
    msg:missionText "DIEBOLD NIXDORF, Inc — Mission; Margin Expansion through continuous improvement and lean journey; Profitable Revenue Growth through new customers and increased wallet share; Free Cash Flow Conversion improvement." ;
    msg:extractedFrom "cleaned_10-K_0000028823-25-000022.txt" ;
    msg:servesStakeholder inst:DIEBOLD_NIXDORF_Inc_Stakeholder_Customers ;
    msg:servesStakeholder inst:DIEBOLD_NIXDORF_Inc_Stakeholder_Government ;
    msg:embodiesValue inst:DIEBOLD_NIXDORF_Inc_Value_Growth ;
    msg:leveragesCapability inst:DIEBOLD_NIXDORF_Inc_Capability_0 ;
    msg:leveragesCapability inst:DIEBOLD_NIXDORF_Inc_Capability_1 ;
    msg:leveragesCapability inst:DIEBOLD_NIXDORF_Inc_Capability_2  .

